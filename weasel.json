{
  "$schema": "weasel.schema.json",
  "theme": "eleven",
  "inline_preedit": true,
  "preedit_type": "composition",
  "ascii_mode": false,
  "global_ascii_status": false,
  "input_mode_indicator": "switch_only",
  "input_mode_indicator_duration_ms": 800,
  "allow_rime_in_secure_fields": false,
  "themeSettings": {
    "abc": {},
    "eleven": {},
    "wasm": {
      "theme": "weaselui",
      "modules": {
        "weaselui": {
          "name": "旧版 Weasel UI"
        },
        "glass": {
          "name": "Glass"
        },
        "orbit": {
          "name": "Orbit · 月轨"
        },
        "statusbar": {
          "name": "经典桌面状态栏"
        }
      }
    }
  },
  "app_options": {
    "cmd.exe": {
      "ascii_mode": true
    },
    "conhost.exe": {
      "ascii_mode": true
    },
    "WindowsTerminal.exe": {
      "ascii_mode": true
    }
  }
}
