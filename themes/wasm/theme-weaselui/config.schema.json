{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "WeaselUI Theme Definition",
  "description": "theme-weaselui 主题定义文件（config.json）",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema 文件的 URI",
      "type": "string"
    },
    "name": {
      "description": "主题显示名称",
      "type": "string"
    },
    "author": {
      "description": "作者",
      "type": "string"
    },
    "horizontal": {
      "description": "是否横向布局",
      "type": "boolean"
    },
    "layout": {
      "description": "窗口布局参数",
      "type": "object",
      "properties": {
        "min_width": {
          "description": "窗口最小宽度",
          "type": "integer"
        },
        "max_width": {
          "description": "窗口最大宽度，0 表示自动",
          "type": "integer"
        },
        "min_height": {
          "description": "窗口最小高度",
          "type": "integer"
        },
        "max_height": {
          "description": "窗口最大高度，0 表示自动",
          "type": "integer"
        },
        "border_width": {
          "description": "边框粗细",
          "type": "integer"
        },
        "margin_x": {
          "description": "水平边距",
          "type": "integer"
        },
        "margin_y": {
          "description": "垂直边距",
          "type": "integer"
        },
        "spacing": {
          "description": "词码间距",
          "type": "integer"
        },
        "candidate_spacing": {
          "description": "候选间距",
          "type": "integer"
        },
        "corner_radius": {
          "description": "边框圆角",
          "type": "number",
          "minimum": 0,
          "maximum": 4096
        },
        "hilite_spacing": {
          "description": "序词间距",
          "type": "integer"
        },
        "hilite_padding": {
          "description": "高亮填充",
          "type": "integer"
        },
        "hilite_corner_radius": {
          "description": "候选项边框圆角",
          "type": "integer"
        },
        "shadow_radius": {
          "description": "窗口阴影",
          "type": "number",
          "minimum": 0,
          "maximum": 250,
          "default": 0
        },
        "shadow_offset_x": {
          "description": "阴影水平偏移",
          "type": "number",
          "minimum": -1024,
          "maximum": 1024
        },
        "shadow_offset_y": {
          "description": "阴影垂直偏移",
          "type": "number",
          "minimum": -1024,
          "maximum": 1024
        }
      },
      "additionalProperties": false
    },
    "color": {
      "description": "颜色：RGB / ARGB",
      "type": "object",
      "properties": {
        "shadow": {
          "$ref": "#/$defs/color",
          "description": "窗口阴影颜色",
          "default": "#40000000"
        },
        "text": {
          "$ref": "#/$defs/color",
          "description": "编码行文字颜色"
        },
        "back": {
          "$ref": "#/$defs/color",
          "description": "背景颜色"
        },
        "border": {
          "$ref": "#/$defs/color",
          "description": "边框颜色"
        },
        "candidate_text": {
          "$ref": "#/$defs/color",
          "description": "候选项文字颜色"
        },
        "comment_text": {
          "$ref": "#/$defs/color",
          "description": "备注项（如拼音）颜色"
        },
        "label": {
          "$ref": "#/$defs/color",
          "description": "标签（如候选项编号）颜色"
        },
        "hilited_text": {
          "$ref": "#/$defs/color",
          "description": "高亮编码行文字颜色"
        },
        "hilited_back": {
          "$ref": "#/$defs/color",
          "description": "高亮编码行文字背景颜色"
        },
        "hilited_candidate_text": {
          "$ref": "#/$defs/color",
          "description": "高亮候选项文本颜色"
        },
        "hilited_candidate_back": {
          "$ref": "#/$defs/color",
          "description": "高亮候选项文本背景颜色"
        },
        "hilited_comment_text": {
          "$ref": "#/$defs/color",
          "description": "高亮候选项备注颜色"
        },
        "hilited_label": {
          "$ref": "#/$defs/color",
          "description": "高亮候选项标签颜色"
        }
      },
      "additionalProperties": false
    },
    "font_face": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "label_font_face": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "comment_font_face": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "label_format": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "font_point": {
      "type": "number",
      "minimum": 3,
      "maximum": 384,
      "description": "字号（pt）"
    },
    "label_font_point": {
      "type": "number",
      "minimum": 3,
      "maximum": 384,
      "description": "字号（pt）"
    },
    "comment_font_point": {
      "type": "number",
      "minimum": 3,
      "maximum": 384,
      "description": "字号（pt）"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "color": {
      "description": "十六进制颜色，可选 # 前缀，6 位 RRGGBB 或 8 位 AARRGGBB",
      "type": "string",
      "pattern": "^#?(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    }
  },
  "examples": [
    {
      "name": "碧水 / Aqua",
      "author": "佛振 <chen.sst@gmail.com>",
      "horizontal": true,
      "layout": {
        "min_width": 160,
        "max_width": 0,
        "min_height": 0,
        "max_height": 0,
        "border_width": 3,
        "margin_x": 12,
        "margin_y": 12,
        "spacing": 10,
        "candidate_spacing": 5,
        "corner_radius": 4,
        "hilite_spacing": 4,
        "hilite_padding": 2,
        "hilite_corner_radius": 4,
        "shadow_radius": 0,
        "shadow_offset_x": 4,
        "shadow_offset_y": 4
      },
      "color": {
        "shadow": "#40000000",
        "text": "#000000",
        "back": "#eeeeec",
        "border": "#e0e0e0",
        "candidate_text": "#000000",
        "comment_text": "#4f4f4e",
        "label": "#4f4f4e",
        "hilited_text": "#000000",
        "hilited_back": "#d4d4d4",
        "hilited_candidate_text": "#ffffff",
        "hilited_candidate_back": "#0a3afa",
        "hilited_comment_text": "#4f4f4e",
        "hilited_label": "#adbdfd"
      }
    }
  ]
}
