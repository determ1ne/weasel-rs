{
  "$schema": "config.schema.json",
  "name": "碧水 / Aqua",
  "author": "佛振 <chen.sst@gmail.com>",
  "horizontal": false,
  "font_face": "Microsoft YaHei",
  "label_font_face": "Microsoft YaHei",
  "comment_font_face": "Microsoft YaHei",
  "font_point": 14,
  "label_font_point": 14,
  "comment_font_point": 14,
  "label_format": "%s.",
  "layout": {
    "min_width": 160,
    "max_width": 0,
    "min_height": 0,
    "max_height": 0,
    "border_width": 3,
    "margin_x": 12,
    "margin_y": 12,
    "spacing": 10,
    "candidate_spacing": 5,
    "corner_radius": 4,
    "hilite_spacing": 4,
    "hilite_padding": 2,
    "hilite_corner_radius": 4,
    "shadow_radius": 0,
    "shadow_offset_x": 4,
    "shadow_offset_y": 4
  },
  "color": {
    "shadow": "#40000000",
    "text": "#000000",
    "back": "#eeeeec",
    "border": "#e0e0e0",
    "candidate_text": "#000000",
    "comment_text": "#4f4f4e",
    "label": "#4f4f4e",
    "hilited_text": "#000000",
    "hilited_back": "#d4d4d4",
    "hilited_candidate_text": "#ffffff",
    "hilited_candidate_back": "#0a3afa",
    "hilited_comment_text": "#4f4f4e",
    "hilited_label": "#adbdfd"
  }
}
