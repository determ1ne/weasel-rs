{
  "version": 2,
  "module": "weasel_v2",
  "doc": [
    "ABI签名与语义编码的唯一来源；生成SDK声明和枚举，禁止手工修改生成文件。",
    "仅支持wasm32：内存参数是u32线性内存偏移/长度，仅在同步调用内有效；memory64明确拒绝。坐标DIP，颜色ARGB，字符串UTF-8，preedit光标UTF-16。",
    "必须独立导出theme_abi_version() -> i32和theme_capabilities() -> i32；前者返回2，后者返回Capability位集合。声明查询不得调用host接口。",
    "默认配置唯一来源为weasel.settings自定义段的defaults对象；宿主解析后覆盖用户设置。无段使用空对象，损坏/重复/超限报错。",
    "host自动开始事件展示事务；返回FrameResult.Present发布整帧，Keep保留旧画面，负错误或trap回滚。",
    "创建返回ErrorCode.Success；可选theme_destroy释放前调用。资源随实例兜底回收。"
  ],
  "enums": [
    {
      "name": "ViewField",
      "doc": "只读快照整数属性。ItemEnabled使用候选index，其余index必须为0。AsciiMode/TotalItemCount的-1表示未知。",
      "values": {
        "ContentId": 0,
        "Active": 1,
        "Visible": 2,
        "AsciiMode": 3,
        "ItemCount": 4,
        "SelectedIndex": 5,
        "PageStart": 6,
        "TotalItemCount": 7,
        "CanPagePrevious": 8,
        "CanPageNext": 9,
        "HasPreedit": 10,
        "CursorUtf16": 11,
        "HasSnapshot": 12,
        "ItemEnabled": 13,
        "AnchorValid": 14,
        "AnchorLeft": 15,
        "AnchorTop": 16,
        "AnchorRight": 17,
        "AnchorBottom": 18
      }
    },
    {
      "name": "ViewStringField",
      "doc": "只读快照字符串属性。Primary/Secondary使用候选index，Preedit的index必须为0。",
      "values": {
        "Primary": 0,
        "Secondary": 1,
        "Preedit": 2
      }
    },
    {
      "name": "ConfigScope",
      "doc": "只暴露模块配置与允许读取的全局展示设置，不包含其他应用配置。",
      "values": {
        "Module": 1,
        "Global": 2
      }
    },
    {
      "name": "DataKind",
      "doc": "DataKind",
      "values": {
        "Missing": 0,
        "Null": 1,
        "Bool": 2,
        "Number": 3,
        "String": 4,
        "Array": 5,
        "Object": 6
      }
    },
    {
      "name": "ResourceMetric",
      "doc": "资源度量，单位DIP；Baseline仅适用于文本布局。",
      "values": {
        "Width": 0,
        "Height": 1,
        "Baseline": 2
      }
    },
    {
      "name": "EventKind",
      "doc": "host到guest的统一事件种类。",
      "values": {
        "View": 0,
        "Appearance": 1,
        "Hide": 2,
        "Pointer": 3,
        "Animation": 4
      }
    },
    {
      "name": "PointerPhase",
      "doc": "取消和离开不能提交点击；取消表示捕获丢失或宿主取消。",
      "values": {
        "Down": 0,
        "Move": 1,
        "Up": 2,
        "Leave": 3,
        "Cancel": 4
      }
    },
    {
      "name": "Action",
      "doc": "Action",
      "values": {
        "Item": 0,
        "Previous": 1,
        "Next": 2,
        "Emoji": 3,
        "Dismiss": 4
      }
    },
    {
      "name": "FrameResult",
      "doc": "事件成功返回值。Keep丢弃本次画面修改，Present替换整帧（可为空）；失败返回负ErrorCode。",
      "values": {
        "Keep": 0,
        "Present": 1
      }
    },
    {
      "name": "ErrorCode",
      "doc": "创建/资源操作：0成功或正句柄，负数失败。事件只允许FrameResult或负错误码。",
      "values": {
        "Success": 0,
        "NotFound": -1,
        "InvalidArgument": -2,
        "InvalidHandle": -3,
        "ResourceLimit": -6,
        "Internal": -7
      }
    },
    {
      "name": "Mode",
      "doc": "Mode",
      "values": {
        "Live": 0,
        "Preview": 1
      }
    },
    {
      "name": "LogLevel",
      "doc": "LogLevel",
      "values": {
        "Trace": 0,
        "Debug": 1,
        "Info": 2,
        "Warn": 3,
        "Error": 4
      }
    },
    {
      "name": "Capability",
      "doc": "能力位，可按位或组合；host拒绝未知位。",
      "flags": true,
      "values": {
        "None": 0,
        "Preedit": 1,
        "Resident": 2
      }
    },
    {
      "name": "LayerProperty",
      "doc": "装饰层可动画属性；偏移为DIP，缩放以层左上角为原点。",
      "values": {
        "Opacity": 0,
        "OffsetX": 1,
        "OffsetY": 2,
        "ScaleX": 3,
        "ScaleY": 4
      }
    },
    {
      "name": "Easing",
      "doc": "SDK和原生动画的时间曲线。",
      "values": {
        "Linear": 0,
        "SmoothStep": 1,
        "EaseIn": 2,
        "EaseOut": 3
      }
    },
    {
      "name": "LayerStop",
      "doc": "停止在当前显示值或立即到达目标。",
      "values": {
        "Current": 0,
        "End": 1
      }
    }
  ],
  "functions": [
    {
      "name": "push_transform",
      "doc": "绘制状态栈，最多32层；只影响绘制，不影响panel/anchor/hit_region。\n变换为局部到父坐标的仿射矩阵(m11,m12,m21,m22,dx,dy)，可嵌套。",
      "params": [
        {
          "name": "m11",
          "type": "f32"
        },
        {
          "name": "m12",
          "type": "f32"
        },
        {
          "name": "m21",
          "type": "f32"
        },
        {
          "name": "m22",
          "type": "f32"
        },
        {
          "name": "dx",
          "type": "f32"
        },
        {
          "name": "dy",
          "type": "f32"
        }
      ],
      "result": "void",
      "group": "draw"
    },
    {
      "name": "push_clip",
      "doc": "当前坐标系下的矩形裁剪。旋转后的裁剪使用其轴对齐包围框。",
