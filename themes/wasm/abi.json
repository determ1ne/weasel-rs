        {
          "name": "id",
          "type": "i32"
        },
        {
          "name": "property",
          "type": "i32"
        },
        {
          "name": "to",
          "type": "f32"
        },
        {
          "name": "duration_ms",
          "type": "f64"
        },
        {
          "name": "easing",
          "type": "i32"
        }
      ],
      "result": "void",
      "group": "layers"
    },
    {
      "name": "layer_stop",
      "doc": "停止属性动画；behavior为LayerStop。",
      "params": [
        {
          "name": "id",
          "type": "i32"
        },
        {
          "name": "property",
          "type": "i32"
        },
        {
          "name": "behavior",
          "type": "i32"
        }
      ],
      "result": "void",
      "group": "layers"
    },
    {
      "name": "layer_clip",
      "doc": "设置内容坐标系中的固定矩形裁剪；enabled=0取消。裁剪不随图层变换，影响绘制与命中。",
