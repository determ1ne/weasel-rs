      "params": [
        {
          "name": "deadline_ms",
          "type": "f64"
        }
      ],
      "result": "void"
    },
    {
      "name": "cancel_wakeup",
      "doc": "取消待处理 WASM 唤醒；不停止独立的宿主图层动画。",
      "group": "animation",
      "params": [],
      "result": "void"
    },
    {
      "name": "layer_content",
      "doc": "选择并清空此装饰层命令，正ID稳定且最多8层；id=0回到主画面。只能在事件内调用，切换时绘图栈必须平衡。",
      "params": [
        {
          "name": "id",
          "type": "i32"
        },
        {
          "name": "width",
          "type": "f32"
        },
        {
          "name": "height",
          "type": "f32"
        }
      ],
      "result": "void",
      "group": "layers"
    },
    {
      "name": "layer_remove",
      "doc": "移除装饰层及动画；随Present生效。",
      "params": [
        {
          "name": "id",
          "type": "i32"
        }
      ],
      "result": "void",
      "group": "layers"
    },
    {
      "name": "layer_set",
      "doc": "立即设置属性并替换该属性动画；随Present生效。",
