        {
          "name": "level",
          "type": "i32"
        },
        {
          "name": "ptr",
          "type": "ptr"
        },
        {
          "name": "len",
          "type": "i32"
        }
      ],
      "result": "void",
      "group": "diagnostics"
    },
    {
      "name": "report_notice",
      "doc": "需要用户处理的问题，进入broker通知通道；不要用于调试日志。",
