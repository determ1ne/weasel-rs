        {
          "name": "id",
          "type": "i32"
        },
        {
          "name": "property",
          "type": "i32"
        },
        {
          "name": "value",
          "type": "f32"
        }
      ],
      "result": "void",
      "group": "layers"
    },
    {
      "name": "layer_animate",
      "doc": "从当前显示值转向新目标；同属性替换不排队。duration_ms最多3600000；时长为零时立即到目标。",
