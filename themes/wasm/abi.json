      "group": "interaction"
    },
    {
      "name": "request_frame",
      "doc": "合并的下一动画帧请求；未再次请求则停止。",
      "params": [],
      "result": "void",
      "group": "animation"
    },
    {
      "name": "time_ms",
      "doc": "宿主进程单调毫秒，同theme_event的now；不是Unix日期。",
      "params": [],
      "result": "f64",
      "group": "animation"
    },
    {
      "name": "log",
      "doc": "普通日志，level为LogLevel；UTF-8最多4096字节，不弹用户通知。",
