import { Button, LineEdit, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
import { IconAction } from "app-options.slint";
export struct WasmEntry { id: string, name: string, file: string, expanded: bool, overridden: bool, name-overridden: bool, file-overridden: bool, active: bool }
export component WasmModules inherits VerticalBox {
    in property <bool> enabled;
    in property <[WasmEntry]> entries;
    callback action(string, string, string, string) -> string;
    private property <bool> expanded: false;
    private property <string> new-id;
    private property <string> error;
    padding: 0px; spacing: 6px;
    Rectangle {
        background: Palette.control-background; border-radius: 6px;
        HorizontalBox {
            padding: 16px; spacing: 12px;
            VerticalBox {
                padding: 0px; spacing: 4px;
                Text { text: "WASM 模块"; font-size: 17px; font-weight: 600; }
                Text { text: "modules"; font-size: 12px; opacity: 0.65; }
                Text { text: "名称和文件路径可选；模块配置显示在当前主题设置中。"; font-size: 12px; wrap: word-wrap; }
            }
            Rectangle {
                width: 100px; min-height: 32px;
                Button { text: "添加新项"; width: 100px; height: 32px;
                    y: (parent.height - self.height) / 2; enabled: root.enabled;
                    clicked => { root.new-id = ""; root.error = ""; add-popup.show(); } }
            }
            IconAction { icon: root.expanded ? @image-url("unfold_less.svg") : @image-url("unfold_more.svg");
                label: "展开或收起模块"; clicked => { root.expanded = !root.expanded; } }
        }
    }
    if root.expanded: VerticalBox {
        padding: 0px; padding-left: 24px; spacing: 6px;
        for entry in root.entries: Rectangle {
            background: Palette.control-background; border-radius: 6px;
            VerticalBox {
                padding: 16px; spacing: 8px;
                HorizontalBox {
                    padding: 0px; spacing: 12px;
                    Text { text: entry.id; font-size: 16px; vertical-alignment: center; }
                    Rectangle {
                        width: 76px; min-height: 32px;
                        Button { text: entry.active ? "当前模块" : "使用"; width: 76px; height: 32px;
                            y: (parent.height - self.height) / 2; enabled: root.enabled && !entry.active;
                            clicked => { root.error = root.action("select", entry.id, "", ""); } }
                    }
                    IconAction { icon: @image-url("reset_settings.svg"); label: "清除模块用户覆盖";
                        enabled: root.enabled && entry.overridden;
                        clicked => { root.error = root.action("remove", entry.id, "", ""); } }
                    IconAction { icon: entry.expanded ? @image-url("unfold_less.svg") : @image-url("unfold_more.svg");
                        label: "展开或收起模块设置"; clicked => { entry.expanded = !entry.expanded; } }
                }
                if entry.expanded: VerticalBox {
                    padding: 0px; padding-left: 16px; spacing: 8px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 12px;
                        VerticalBox {
                            padding: 0px; spacing: 4px;
                            Text { text: "显示名称"; font-size: 15px; }
                            Text { text: "name"; font-size: 12px; opacity: 0.65; }
                            Text { text: "可选的模块显示名称。"; font-size: 12px; opacity: 0.75; wrap: word-wrap; }
                        }
                        Rectangle {
                            width: 210px; min-height: 32px;
                            LineEdit { width: parent.width; height: 32px; y: (parent.height - self.height) / 2;
                                enabled: root.enabled; text <=> entry.name; placeholder-text: "可选";
                                edited => { root.error = root.action("set", entry.id, "name", self.text); } }
                        }
                        IconAction { icon: @image-url("reset_settings.svg"); label: "恢复名称继承";
                            enabled: root.enabled && entry.name-overridden;
                            clicked => { root.error = root.action("reset", entry.id, "name", ""); } }
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 12px;
                        VerticalBox {
                            padding: 0px; spacing: 4px;
                            Text { text: "文件路径"; font-size: 15px; }
                            Text { text: "file"; font-size: 12px; opacity: 0.65; }
                            Text { text: "留空按模块标识自动查找。"; font-size: 12px; opacity: 0.75; wrap: word-wrap; }
                        }
                        Rectangle {
                            width: 210px; min-height: 32px;
                            LineEdit { width: parent.width; height: 32px; y: (parent.height - self.height) / 2;
                                enabled: root.enabled; text <=> entry.file; placeholder-text: "留空自动查找";
                                edited => { root.error = root.action("set", entry.id, "file", self.text); } }
                        }
                        IconAction { icon: @image-url("reset_settings.svg"); label: "恢复路径继承";
                            enabled: root.enabled && entry.file-overridden;
                            clicked => { root.error = root.action("reset", entry.id, "file", ""); } }
                    }
                    Text { text: "空路径：先查程序目录 theme-wasm/<id>.wasm，再查用户目录。新增模块或修改路径后，保存并重新打开设置以加载描述。";
                        font-size: 12px; opacity: 0.7; wrap: word-wrap; }
                }
            }
        }
        if root.error != "": Text { text: root.error; wrap: word-wrap; }
    }
    add-popup := PopupWindow {
        width: 380px; height: 220px; close-policy: no-auto-close;
        Rectangle {
            background: Palette.background; border-radius: 8px;
            VerticalBox {
                padding: 20px; spacing: 12px;
                Text { text: "添加 WASM 模块"; font-size: 20px; }
                LineEdit { text <=> root.new-id; placeholder-text: "模块标识，如 weaselui"; init => { self.focus(); } }
                Text { text: root.error; font-size: 12px; wrap: word-wrap; }
                HorizontalBox {
                    alignment: end;
                    Button { text: "取消"; clicked => { add-popup.close(); } }
                    Button { text: "添加"; enabled: root.new-id != "";
                        clicked => { root.error = root.action("add", root.new-id, "", "");
                            if root.error == "" { root.expanded = true; add-popup.close(); } } }
                }
            }
        }
    }
}
